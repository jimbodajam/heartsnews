# Copy to .env (which git ignores) and fill in. Without a key, bulletins are written from templates.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a specific model instead of Google's "latest flash" alias.
# GEMINI_MODEL=gemini-flash-latest

# Instagram Graph API (Business Discovery), for the club's team-news graphic (issue #40). Also Worker secrets and GitHub Actions secrets.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# The channel's memory (D1 behind the live Worker): the same token as the Worker's STORE_TOKEN secret.
# Without it, bulletins build with no memory of what aired or what the presenters said.
STORE_TOKEN=
# Optional: another store, e.g. `npm run worker:dev`'s http://localhost:8787/store.
# STORE_URL=
