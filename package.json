{
  "name": "heartsnews",
  "private": true,
  "type": "module",
  "workspaces": [
    "pipeline",
    "site",
    "worker"
  ],
  "scripts": {
    "collect": "npm -w pipeline run collect",
    "voice": "npm -w pipeline run voice --",
    "bulletin": "npm -w pipeline run bulletin --",
    "snapshot": "npm -w pipeline run snapshot",
    "pronounce": "npm -w pipeline run pronounce --",
    "pixelate": "npm -w pipeline run pixelate --",
    "faces": "npm -w pipeline run faces",
    "adverts": "npm -w pipeline run adverts",
    "gpu:setup": "bash tools/gpu/setup.sh",
    "publish-site": "npm -w pipeline run publish-site",
    "live": "npm -w pipeline run live --",
    "breaking": "npm -w pipeline run breaking --",
    "record": "npm -w pipeline run record --",
    "trim-recording": "npm -w pipeline run trim-recording --",
    "replay": "npm -w pipeline run replay --",
    "store:import": "npm -w pipeline run store:import --",
    "worker:dev": "npm -w worker run dev",
    "worker:deploy": "npm -w worker run deploy",
    "dev": "npm -w site run dev",
    "build": "npm -w site run build",
    "test": "node --test \"shared/test/*.test.ts\" \"pipeline/test/*.test.ts\"",
    "typecheck": "npm -w pipeline run typecheck && npm -w site run typecheck && npm -w worker run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
